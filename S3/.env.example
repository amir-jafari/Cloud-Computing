# Copy this file to .env and put your real keys THERE.
# This file is tracked by git — never paste real credentials into it.
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...

# Required if your access key starts with ASIA (temporary STS credentials,
# e.g. AWS Academy / Learner Lab). Omit for long-term AKIA keys.
AWS_SESSION_TOKEN=